<Application x:Class="Lab11_Navigation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lab11_Navigation"
             xmlns:vm="clr-namespace:Lab11_Navigation.ViewModels"
             xmlns:v="clr-namespace:Lab11_Navigation.Views">
    <Application.Resources>
        <!-- Связь ContactsListViewModel -> ContactsListView -->
        <DataTemplate DataType="{x:Type vm:ContactsListViewModel}">
            <v:ContactsListView />
        </DataTemplate>

        <!-- Связь AboutViewModel -> AboutView -->
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <v:AboutView />
        </DataTemplate>

        <!-- Связь ContactEditViewModel -> ContactEditView -->
        <DataTemplate DataType="{x:Type vm:ContactEditViewModel}">
            <v:ContactEditView />
        </DataTemplate>
    </Application.Resources>
</Application>
