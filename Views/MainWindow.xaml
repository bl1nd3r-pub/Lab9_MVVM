<Window x:Class="Lab11_Navigation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab11_Navigation.Views"
        mc:Ignorable="d"
        Title="телефонная книга - навигация" Height="500" Width="800">
    <DockPanel>
        <!-- Навигационная панелька -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#f0f0f0" Margin="0,0,0,10">
            <Button Content="Контакты" Command="{Binding ShowContactsCommand}" Margin="5" Padding="10,5"/>
            <Button Content="О программе" Command="{Binding ShowAboutCommand}" Margin="5" Padding="10,5"/>
        </StackPanel>

        <!-- Область для отображения контента -->
        <ContentControl Content="{Binding NavigationService.CurrentViewModel}" />
    </DockPanel>
</Window>
